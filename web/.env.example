# Naruhodo+ Web アプリ用の環境変数
# このファイルをコピーして web/.env.local を作り、実際の値を入れる
#   cp .env.example .env.local
# .env.local は Git 管理しない（.gitignore 済み）
# Vercel にデプロイする場合は同じ値を Vercel の Environment Variables にも登録する
# ※ このファイル（.env.example）はコミットされる。実際の値は書かないこと

# ------------------------------------------------------------------
# ブラウザにも渡ってよい値（NEXT_PUBLIC_ 接頭辞）
# ------------------------------------------------------------------

# Supabase の API URL（Settings → API の「API URL」）
# 末尾にパス（/rest/v1/ 等）は付けない
# 例: https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の Publishable key（sb_publishable_... / 旧 anon key）
# 公開されても問題ない鍵。将来ブラウザ側で使う可能性があるので保持しておく
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# サーバー専用（ブラウザに渡さない / NEXT_PUBLIC_ を付けない）
# ------------------------------------------------------------------

# Supabase の Secret key（sb_secret_... / 旧 service_role key）
# RLS を貫通する秘密鍵。Next.js の API ルート内でのみ使用する
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key（用語調べ機能・任意）。未設定ならその機能は無効になる
# https://console.groq.com → API Keys（クレカ不要）
GROQ_API_KEY=
