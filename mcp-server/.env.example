# Naruhodo+ MCP サーバー用の環境変数
# このファイルをコピーして mcp-server/.env.local を作り、実際の値を入れる
#   cp .env.example .env.local
# .env.local は Git 管理しない（.gitignore 済み）
# ※ このファイル（.env.example）はコミットされる。実際の値は書かないこと

# Supabase の API URL（Settings → API の「API URL」）
# 末尾にパス（/rest/v1/ 等）は付けない
# 例: https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Supabase の Secret key（sb_secret_... / 旧 service_role key）
# RLS を貫通する秘密鍵。MCP サーバーはローカルの信頼された処理なのでここで直接保持してよい
# 絶対に公開・コミットしないこと
SUPABASE_SERVICE_ROLE_KEY=

# このMCPサーバーを呼び出すAIの名前（quizzes.created_by / knowledge の記録用）
# 例: claude / codex
MCP_CLIENT_NAME=claude

# 保存前プレビュー（下書き→確定の2段階）を既定でONにするか
# true にすると add_knowledge が下書きを返し、確定用の呼び出しを待つ
NARUHODO_PREVIEW_BEFORE_SAVE=true
